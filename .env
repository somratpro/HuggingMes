# =================================================================
# 1. CORE GATEWAY & SYSTEM SETTINGS
# =================================================================
GATEWAY_TOKEN=your_secure_gateway_password_here
HF_TOKEN=hf_your_write_access_token_here

# =================================================================
# 2. DEFAULT RUNTIME LLM CONFIGURATION (Dynamic Defaults)
# =================================================================
# LLM_PROVIDER options: groq, gemini, openrouter, openai, anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama3-70b-8192

# =================================================================
# 3. PROVIDER API KEYS (Keep these in SECRETS)
# =================================================================
# --- Groq Configuration ---
GROQ_API_KEY=gskYourGroqKeyHere

# --- Google Gemini Configuration ---
GEMINI_API_KEY=AIzaSyYourGeminiKeyHere

# --- OpenRouter Configuration ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# --- OpenAI Configuration (Optional fallback/alternative) ---
OPENAI_API_KEY=sk-proj-your-openai-key-here

# =================================================================
# 4. TELEGRAM INTERFACE & AUTOMATION
# =================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ALLOWED_USERS=your_telegram_user_id

# --- Keep Alive Monitoring ---
CLOUDFLARE_WORKERS_TOKEN=your_cloudflare_worker_token_here
